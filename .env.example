# Supabase project settings (get from https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: e2e auth flow tests will run if these are set
# E2E_ADMIN_EMAIL=admin-test@itdev.gr
# E2E_ADMIN_PASSWORD=replace-me

# Yeastar PBX caller-ID lookup (set the secret value only in Vercel, never commit it)
PBX_LOOKUP_SECRET=
# Base URL used to build the deep-link back into the CRM from the PBX popup
PBX_DEEPLINK_BASE=https://itdevcrm.vercel.app
